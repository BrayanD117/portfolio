---
import "../components/styles/ExperienceSection.css";
import en from "../i18n/en.json";
import es from "../i18n/es.json";
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
const locale = Astro.currentLocale;
const t = locale === "es" ? es : en;

const experienceData = t.experience || (t as any).workExperience;
---

<section
  id="experience"
  class="relative bg-gradient-to-br from-[#0f172a] via-[#1e293b] to-[#0f172a] text-white py-24 overflow-hidden experience-section"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(16,185,129,0.05),transparent_60%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(6,182,212,0.05),transparent_60%)]"
  >
  </div>

  <div class="container mx-auto px-6 sm:px-12 relative z-10">
    <div class="text-center mb-20 experience-header">
      <span class="text-emerald-400 text-sm font-mono mb-2 block">04.</span>
      <h2 class="text-4xl sm:text-5xl font-bold mb-4">
        {experienceData.title}
      </h2>
      <div
        class="w-20 h-1 bg-gradient-to-r from-emerald-400 to-cyan-400 mx-auto"
      >
      </div>
    </div>

    <div class="relative max-w-4xl mx-auto">
      <div
        class="absolute left-0 md:left-1/2 transform md:-translate-x-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-slate-600 to-transparent timeline-line"
      >
      </div>

      <div class="space-y-12">
        {
          experienceData.timeline.map((item: any, index: number) => (
            <div
              class={`relative flex flex-col md:flex-row gap-8 items-center experience-item ${index % 2 === 0 ? "md:flex-row-reverse" : ""}`}
            >
              <div class="absolute left-[-5px] md:left-1/2 md:-ml-[5px] w-[11px] h-[11px] rounded-full bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)] z-20 mt-1.5 md:mt-0 timeline-dot">
                <div class="absolute inset-0 rounded-full bg-emerald-400 animate-ping opacity-20" />
              </div>

              <div class="hidden md:block w-1/2 text-right px-8 experience-date">
                <span class="text-emerald-400 font-mono text-sm tracking-wider">
                  {item.date}
                </span>
              </div>

              <div class="w-full md:w-1/2 pl-8 md:pl-0 experience-card-wrapper">
                <div
                  class={`bg-slate-800/80 backdrop-blur-md p-6 rounded-xl border border-slate-700 hover:border-emerald-500/30 transition-all duration-300 shadow-xl group experience-card ${index % 2 === 0 ? "md:mr-8" : "md:ml-8"}`}
                >
                  <span class="md:hidden text-emerald-400 font-mono text-xs mb-2 block">
                    {item.date}
                  </span>

                  <h3 class="text-xl font-bold text-white mb-2 group-hover:text-emerald-400 transition-colors">
                    {item.role}
                  </h3>
                  <div class="text-white font-medium mb-4 text-sm flex items-center gap-2">
                    <i class="fas fa-building text-xs text-cyan-400" />
                    {item.company}
                  </div>

                  <p class="text-gray-200 text-sm leading-relaxed mb-4 font-light">
                    {item.description}
                  </p>

                  {item.technologies && item.technologies.length > 0 && (
                    <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-700">
                      {item.technologies.map((tech: string) => (
                        <span class="px-2 py-1 text-xs rounded bg-slate-700 text-gray-200 border border-slate-600">
                          {tech}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    let ctx: gsap.Context | null = null;

    const initAnimations = () => {
      if (ctx) {
        ctx.revert();
        ctx = null;
      }

      setTimeout(() => {
        ctx = gsap.context(() => {
          gsap.from(".experience-header", {
            scrollTrigger: {
              trigger: ".experience-header",
              start: "top 85%",
              toggleActions: "play none none none",
            },
            opacity: 0,
            y: 20,
            duration: 0.6,
            ease: "power2.out",
          });

          gsap.from(".timeline-line", {
            scrollTrigger: {
              trigger: ".experience-section",
              start: "top 70%",
              end: "bottom 70%",
              scrub: 1,
            },
            scaleY: 0,
            transformOrigin: "top center",
            ease: "none",
          });

          const items = document.querySelectorAll(".experience-item");

          items.forEach((item, index) => {
            const card = item.querySelector(".experience-card") as HTMLElement;
            const date = item.querySelector(".experience-date") as HTMLElement;
            const dot = item.querySelector(".timeline-dot") as HTMLElement;

            if (!card || !dot) return;

            gsap.set(card, { opacity: 0 });
            gsap.set(dot, { scale: 0, opacity: 0 });
            if (date) gsap.set(date, { opacity: 0 });

            const isFromRight = index % 2 === 0;
            const cardX = isFromRight ? 100 : -100;
            const dateX = isFromRight ? -100 : 100;

            gsap.set(card, { x: cardX });
            if (date) gsap.set(date, { x: dateX });

            const tl = gsap.timeline({
              scrollTrigger: {
                trigger: item,
                start: "top 75%",
                toggleActions: "play none none none",
              },
            });

            tl.to(dot, {
              scale: 1,
              opacity: 1,
              duration: 0.4,
              ease: "back.out(1.7)",
            });

            tl.to(
              card,
              {
                x: 0,
                opacity: 1,
                duration: 0.8,
                ease: "power2.out",
              },
              "-=0.2"
            );

            if (date) {
              tl.to(
                date,
                {
                  x: 0,
                  opacity: 1,
                  duration: 0.8,
                  ease: "power2.out",
                },
                "<"
              );
            }
          });
        });

        ScrollTrigger.refresh();
      }, 100);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAnimations);
    } else {
      initAnimations();
    }

    document.addEventListener("astro:page-load", initAnimations);
    document.addEventListener("astro:after-swap", () => {
      if (ctx) {
        ctx.revert();
        ctx = null;
      }
    });
  </script>
</section>

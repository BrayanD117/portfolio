---
import "../components/styles/AboutSection.css";
import en from "../i18n/en.json";
import es from "../i18n/es.json";
const locale = Astro.currentLocale;
const t = locale === "es" ? es : en;

const techStack = {
  frontend: [
    { name: "Angular", icon: "devicon-angularjs-plain", color: "text-red-400" },
    {
      name: "React.js",
      icon: "devicon-react-original",
      color: "text-cyan-400",
    },
    { name: "Next.js", icon: "devicon-nextjs-plain", color: "text-white" },
    {
      name: "Tailwind CSS",
      icon: "devicon-tailwindcss-plain",
      color: "text-cyan-400",
    },
    { name: "Figma", icon: "devicon-figma-plain", color: "text-pink-400" },
  ],
  backend: [
    { name: "Node.js", icon: "devicon-nodejs-plain", color: "text-green-400" },
    {
      name: "Express",
      icon: "devicon-express-original",
      color: "text-gray-300",
    },
    { name: "NestJS", icon: "devicon-nestjs-plain", color: "text-red-400" },
    { name: "PHP", icon: "devicon-php-plain", color: "text-purple-400" },
  ],
  database: [
    {
      name: "PostgreSQL",
      icon: "devicon-postgresql-plain",
      color: "text-blue-400",
    },
    { name: "MongoDB", icon: "devicon-mongodb-plain", color: "text-green-400" },
    { name: "Oracle", icon: "devicon-oracle-original", color: "text-red-400" },
    { name: "MariaDB", icon: "devicon-mariadb-plain", color: "text-blue-300" },
  ],
  tools: [
    {
      name: "Git & GitHub",
      icon: "devicon-github-original",
      color: "text-gray-400",
    },
    { name: "Docker", icon: "devicon-docker-plain", color: "text-blue-400" },
    { name: "CI/CD", icon: "devicon-circleci-plain", color: "text-green-400" },
    { name: "Postman", icon: "fas fa-cube", color: "text-orange-400" },
  ],
};
---

<section
  id="about"
  class="relative bg-gradient-to-br from-[#1e293b] via-[#0f172a] to-[#1e293b] text-white py-20 overflow-hidden"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(16,185,129,0.05),transparent_50%)]"
  >
  </div>

  <div class="container mx-auto px-6 sm:px-12 relative z-10">
    <div class="text-center mb-16 about-header">
      <span class="text-emerald-400 text-sm font-mono mb-2 block">01.</span>
      <h2 class="text-4xl sm:text-5xl font-bold mb-4">{t.about.title}</h2>
      <div
        class="w-20 h-1 bg-gradient-to-r from-emerald-400 to-cyan-400 mx-auto"
      >
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-start mb-20">
      <div class="terminal-container">
        <div
          class="bg-slate-800/50 backdrop-blur-sm rounded-lg border border-slate-700/50 shadow-2xl overflow-hidden"
        >
          <div
            class="bg-slate-900/80 px-4 py-3 flex items-center gap-2 border-b border-slate-700/50"
          >
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <span class="text-sm text-gray-400 ml-4 font-mono"
              >~/brayan-dev/bio.json</span
            >
          </div>

          <div class="p-6 font-mono text-sm leading-relaxed terminal-content">
            <div class="space-y-1">
              <div>
                <span class="text-gray-500">→</span>
                <span class="text-cyan-400"
                  >{t.about.terminal.command.split(" ")[0]}</span
                >
                <span class="text-gray-300"
                  >{t.about.terminal.command.split(" ")[1]}</span
                >
              </div>
              <div class="mt-4 text-gray-300">
                <div><span class="text-purple-400">{"{"}</span></div>
                <div class="ml-4">
                  <span class="text-emerald-400">"name"</span>: <span
                    class="text-yellow-300">"{t.about.terminal.name}"</span
                  >,
                </div>
                <div class="ml-4">
                  <span class="text-emerald-400">"role"</span>: <span
                    class="text-yellow-300">"{t.about.terminal.role}"</span
                  >,
                </div>
                <div class="ml-4">
                  <span class="text-emerald-400">"location"</span>: <span
                    class="text-yellow-300">"{t.about.terminal.location}"</span
                  >,
                </div>
                <div class="ml-4">
                  <span class="text-emerald-400">"passion"</span>: <span
                    class="text-yellow-300">"{t.about.terminal.passion}"</span
                  >,
                </div>
                <div class="ml-4">
                  <span class="text-emerald-400">"focus"</span>: <span
                    class="text-purple-400">[</span
                  >{
                    t.about.terminal.focus.map((item: string, i: number) => (
                      <>
                        <span class="text-yellow-300">"{item}"</span>
                        {i < t.about.terminal.focus.length - 1 ? ", " : ""}
                      </>
                    ))
                  }<span class="text-purple-400">]</span>,
                </div>
                <div class="ml-4">
                  <span class="text-emerald-400">"status"</span>: <span
                    class="text-yellow-300">"{t.about.terminal.status}"</span
                  >
                </div>
                <div><span class="text-purple-400">{"}"}</span></div>
              </div>
              <div class="mt-4">
                <span class="text-gray-500">→</span>
                <span class="blinking-cursor">_</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-6 about-content">
        <div class="space-y-4">
          <p class="text-lg text-gray-300 leading-relaxed">
            {t.about.description}
          </p>

          <div class="flex items-center gap-3 text-gray-400">
            <i class="fas fa-map-marker-alt text-emerald-400"></i>
            <span>{t.about.location}</span>
          </div>

          <div class="flex items-center gap-3 text-gray-400">
            <i class="fas fa-language text-emerald-400"></i>
            <span>{t.about.languages}</span>
          </div>

          <div class="flex items-center gap-3 text-gray-400">
            <i class="fas fa-rocket text-emerald-400"></i>
            <span>{t.about.highPerformance}</span>
          </div>

          <div class="flex items-center gap-3 text-gray-400">
            <i class="fas fa-users text-emerald-400"></i>
            <span>{t.about.agile}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="tech-stack-section">
      <div class="text-center mb-12">
        <span class="text-emerald-400 text-sm font-mono mb-2 block">02.</span>
        <h3 class="text-3xl sm:text-4xl font-bold mb-4">
          {t.about.techStack.title}
        </h3>
        <p class="text-gray-400">{t.about.techStack.subtitle}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div
          class="tech-category bg-slate-800/30 backdrop-blur-sm rounded-xl p-6 border border-slate-700/50 hover:border-emerald-500/50 transition-all duration-300"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-10 h-10 bg-blue-500/10 rounded-lg flex items-center justify-center"
            >
              <i class="fas fa-laptop-code text-blue-400 text-xl"></i>
            </div>
            <h4 class="text-xl font-semibold">
              {t.about.techStack.categories.frontend}
            </h4>
          </div>
          <div class="space-y-3">
            {
              techStack.frontend.map((tech) => (
                <div class="flex items-center gap-3 group">
                  <i
                    class={`${tech.icon} ${tech.color} text-2xl group-hover:scale-110 transition-transform`}
                  />
                  <span class="text-gray-300 group-hover:text-white transition-colors">
                    {tech.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="tech-category bg-slate-800/30 backdrop-blur-sm rounded-xl p-6 border border-slate-700/50 hover:border-emerald-500/50 transition-all duration-300"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-10 h-10 bg-green-500/10 rounded-lg flex items-center justify-center"
            >
              <i class="fas fa-server text-green-400 text-xl"></i>
            </div>
            <h4 class="text-xl font-semibold">
              {t.about.techStack.categories.backend}
            </h4>
          </div>
          <div class="space-y-3">
            {
              techStack.backend.map((tech) => (
                <div class="flex items-center gap-3 group">
                  <i
                    class={`${tech.icon} ${tech.color} text-2xl group-hover:scale-110 transition-transform`}
                  />
                  <span class="text-gray-300 group-hover:text-white transition-colors">
                    {tech.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="tech-category bg-slate-800/30 backdrop-blur-sm rounded-xl p-6 border border-slate-700/50 hover:border-emerald-500/50 transition-all duration-300"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-10 h-10 bg-purple-500/10 rounded-lg flex items-center justify-center"
            >
              <i class="fas fa-database text-purple-400 text-xl"></i>
            </div>
            <h4 class="text-xl font-semibold">
              {t.about.techStack.categories.database}
            </h4>
          </div>
          <div class="space-y-3">
            {
              techStack.database.map((tech) => (
                <div class="flex items-center gap-3 group">
                  <i
                    class={`${tech.icon} ${tech.color} text-2xl group-hover:scale-110 transition-transform`}
                  />
                  <span class="text-gray-300 group-hover:text-white transition-colors">
                    {tech.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="tech-category bg-slate-800/30 backdrop-blur-sm rounded-xl p-6 border border-slate-700/50 hover:border-emerald-500/50 transition-all duration-300"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-10 h-10 bg-orange-500/10 rounded-lg flex items-center justify-center"
            >
              <i class="fas fa-tools text-orange-400 text-xl"></i>
            </div>
            <h4 class="text-xl font-semibold">
              {t.about.techStack.categories.tools}
            </h4>
          </div>
          <div class="space-y-3">
            {
              techStack.tools.map((tech) => (
                <div class="flex items-center gap-3 group">
                  <i
                    class={`${tech.icon} ${tech.color} text-2xl group-hover:scale-110 transition-transform`}
                  />
                  <span class="text-gray-300 group-hover:text-white transition-colors">
                    {tech.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
      gsap.from(".about-header", {
        scrollTrigger: {
          trigger: ".about-header",
          start: "top 80%",
          toggleActions: "play none none none",
        },
        opacity: 0,
        y: 30,
        duration: 0.8,
        ease: "power3.out",
        clearProps: "all",
      });

      gsap.from(".terminal-container", {
        scrollTrigger: {
          trigger: ".terminal-container",
          start: "top 80%",
          toggleActions: "play none none none",
        },
        opacity: 0,
        x: -50,
        duration: 1,
        ease: "power3.out",
        clearProps: "all",
      });

      gsap.from(".about-content", {
        scrollTrigger: {
          trigger: ".about-content",
          start: "top 80%",
          toggleActions: "play none none none",
        },
        opacity: 0,
        x: 50,
        duration: 1,
        ease: "power3.out",
        clearProps: "all",
      });

      const techCategories = gsap.utils.toArray(".tech-category") as Element[];
      techCategories.forEach((category, index) => {
        gsap.from(category, {
          scrollTrigger: {
            trigger: category,
            start: "top 85%",
            toggleActions: "play none none none",
          },
          opacity: 0,
          y: 30,
          duration: 0.6,
          delay: index * 0.1,
          ease: "power3.out",
          clearProps: "all",
        });
      });
    });
  </script>

  <style>
    .blinking-cursor {
      animation: blink 1s infinite;
    }

    @keyframes blink {
      0%,
      50% {
        opacity: 1;
      }
      51%,
      100% {
        opacity: 0;
      }
    }
  </style>
</section>
